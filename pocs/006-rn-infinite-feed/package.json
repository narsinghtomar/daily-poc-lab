{
  "name": "rn-infinite-feed",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "yarn test:unit && yarn test:ui",
    "test:unit": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:ui": "jest"
  },
  "dependencies": {
    "@shopify/flash-list": "^2.3.3",
    "@tanstack/react-query": "^5.108.0",
    "expo": "~58.0.25",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@jest/globals": "^30",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "yarn@1.22.22",
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.tsx"
    ],
    "setupFiles": [
      "@shopify/flash-list/jestSetup"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@shopify/flash-list))"
    ]
  }
}
